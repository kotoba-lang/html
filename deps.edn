{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/compiler is a TEST-ONLY dependency, for the parity gate
         ;; that compiles kotoba/html_core.kotoba and requires it to emit
         ;; byte-identical text to html.core (ADR-2607270100 section 10). The
         ;; library itself has no runtime dependency on it.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/compiler.git"
                       ;; document-in-record: :document guest-record field type
                       :git/sha "7691b1aeb7baa22785b6fbb5689133de85dacde6"}}
         :main-opts ["-m" "cognitect.test-runner"]}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
