(ns html-document)

;; Delivery 6 second cutover slice (ADR-2607279200 / ADR-2607270100 §10 /
;; migration plan W6 dependency order css → **html** → …):
;;
;; A *logical UI document* is an ordinary `:document` value — the W4 UI
;; vocabulary (`:tag` / optional `:text` / optional `:attrs` / optional
;; `:children`) — not a host object and not a form-A string call graph.
;; Rendering to an HTML *stream* is pure guest recursion over that document
;; (dual-renderer stream half; DOM reconcile remains host-side W4#4).
;;
;; Form-A (`html_core.kotoba`) remains the oracle for escape / attr / void /
;; closed emission. This module must byte-agree with form-A and with a
;; key-sorted html.core run for the same flat structures. Consumer
;; `html.core` APIs are unchanged.
;;
;; Capability-free (kotoba/pure). Handles are not the application model.

;; --- escape (same four replacements as html.core / form-A) ----------------

(defn esc [s :string] :string
  (string-replace-all
   (string-replace-all
    (string-replace-all
     (string-replace-all s "&" "&amp;")
     "<" "&lt;")
    ">" "&gt;")
   "\"" "&quot;"))

;; --- void-tag detection (subset used by contract corpus) ------------------

(defn void-tag? [tag :string] :bool
  (if (string=? tag "area") true
  (if (string=? tag "base") true
  (if (string=? tag "br") true
  (if (string=? tag "col") true
  (if (string=? tag "embed") true
  (if (string=? tag "hr") true
  (if (string=? tag "img") true
  (if (string=? tag "input") true
  (if (string=? tag "link") true
  (if (string=? tag "meta") true
  (if (string=? tag "param") true
  (if (string=? tag "source") true
  (if (string=? tag "track") true
  (if (string=? tag "wbr") true false)))))))))))))))

;; --- document constructors ------------------------------------------------

(defn text-node [s :string] :document
  (document-string s))

(defn void-node [tag :string] :document
  (document-map :tag (document-string tag) :void (document-bool true)))

(defn void-node-attrs [tag :string attrs :document] :document
  (document-map :tag (document-string tag)
                :void (document-bool true)
                :attrs attrs))

(defn leaf [tag :string text :string] :document
  (document-map :tag (document-string tag)
                :text (document-string text)))

(defn leaf-attrs [tag :string attrs :document text :string] :document
  (document-map :tag (document-string tag)
                :attrs attrs
                :text (document-string text)))

(defn branch [tag :string children :document] :document
  (document-map :tag (document-string tag)
                :children children))

(defn branch-attrs [tag :string attrs :document children :document] :document
  (document-map :tag (document-string tag)
                :attrs attrs
                :children children))

(defn attrs-map [entries :document] :document
  entries)

;; --- field accessors ------------------------------------------------------

(defn tag-of [d :document] :string
  (option-value-of [:option :string]
    (document-string-value
      (option-value-of [:option :document]
        (document-get d :tag) (document-null)))
    "div"))

(defn text-of [d :document] :string
  (option-value-of [:option :string]
    (document-string-value
      (option-value-of [:option :document]
        (document-get d :text) (document-null)))
    ""))

(defn kids-of [d :document] :document
  (option-value-of [:option :document]
    (document-get d :children) (document-vector)))

(defn attrs-of [d :document] :document
  (option-value-of [:option :document]
    (document-get d :attrs) (document-map)))

(defn void-of [d :document] :bool
  (option-value-of [:option :bool]
    (document-bool-value
      (option-value-of [:option :document]
        (document-get d :void) (document-null)))
    false))

;; --- attribute emission (key-sorted via document-map-entry-at) ------------

(defn attr-pair [name :string value :string] :string
  (string-concat " "
                 (string-concat name
                                (string-concat "=\""
                                               (string-concat (esc value) "\"")))))

(defn bool-attr [name :string] :string
  (string-concat " " name))

(defn render-attr-entry [entry :document] :string
  ;; entry is a vector document [keyword-doc, value-doc]
  (let [kdoc (option-value-of [:option :document]
               (document-vector-at entry 0) (document-null))
        vdoc (option-value-of [:option :document]
               (document-vector-at entry 1) (document-null))
        name (keyword-name
              (option-value-of [:option :keyword]
                (document-keyword-value kdoc) :missing))]
    (if (= (document-kind vdoc) :bool)
      (if (option-value-of [:option :bool] (document-bool-value vdoc) false)
        (bool-attr name)
        "")
      (attr-pair name
                 (option-value-of [:option :string]
                   (document-string-value vdoc) "")))))

(defn render-attrs-from [attrs :document i :i64 n :i64 acc :string] :string
  (if (>= i n)
    acc
    (render-attrs-from attrs (+ i 1) n
      (string-concat acc
        (render-attr-entry
         (option-value-of [:option :document]
           (document-map-entry-at attrs i) (document-null)))))))

(defn render-attrs [d :document] :string
  (let [a (attrs-of d)]
    (if (= (document-kind a) :map)
      (render-attrs-from a 0 (document-count a) "")
      "")))

;; --- render logical UI document → HTML stream -----------------------------

(defn render-kids [kids :document i :i64 n :i64 acc :string] :string
  (if (>= i n)
    acc
    (render-kids kids (+ i 1) n
      (string-concat acc
        (render (option-value-of [:option :document]
                  (document-vector-at kids i) (document-null)))))))

(defn render [d :document] :string
  (if (= (document-kind d) :string)
    (esc (option-value-of [:option :string] (document-string-value d) ""))
    (if (void-of d)
      (string-concat "<"
        (string-concat (tag-of d)
          (string-concat (render-attrs d) ">")))
      (if (void-tag? (tag-of d))
        (string-concat "<"
          (string-concat (tag-of d)
            (string-concat (render-attrs d) ">")))
        (if (string=? (text-of d) "")
          (string-concat "<"
            (string-concat (tag-of d)
              (string-concat (render-attrs d)
                (string-concat ">"
                  (string-concat (render-kids (kids-of d) 0 (document-count (kids-of d)) "")
                    (string-concat "</" (string-concat (tag-of d) ">")))))))
          (string-concat "<"
            (string-concat (tag-of d)
              (string-concat (render-attrs d)
                (string-concat ">"
                  (string-concat (esc (text-of d))
                    (string-concat "</" (string-concat (tag-of d) ">"))))))))))))

(defn html5 [body :document] :string
  (string-concat "<!DOCTYPE html>\n" (render body)))

;; --- identity (W4 print/sha256 surface) -----------------------------------

(defn node-digest [d :document] :string
  (document-sha256 d))

(defn node-print [d :document] :string
  (document-print d))

(defn node-read [s :string] :document
  (document-read s))

(defn main []
  (string-byte-length
   (render
    (branch "div"
      (document-vector
        (leaf "h1" "Hello")
        (void-node "br"))))))
